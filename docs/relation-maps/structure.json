              ],
              "references": [
                "Lesson 09"
              ]
            },
            {
              "name": "放射と耐圧",
              "lines": [
                "放射能力 → 薬剤の放射を確認",
                "耐圧性能 → 水圧で容器を確認"
              ],
              "references": [
                "Lesson 09"
              ]
            }
          ]
        },
        {
          "title": "分解と充てん",
          "topics": [
            {
              "name": "蓄圧式",
              "lines": [
